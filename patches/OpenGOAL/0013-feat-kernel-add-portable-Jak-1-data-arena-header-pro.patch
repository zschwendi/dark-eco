 game/kernel/jak1/data_arena.cpp |  87 +++++++++++++++++++++++
 game/kernel/jak1/data_arena.h   |  54 ++++++++++++++
 test/CMakeLists.txt             |   4 ++
 test/test_jak1_data_arena.cpp   | 122 ++++++++++++++++++++++++++++++++
 5 files changed, 269 insertions(+)
 create mode 100644 game/kernel/jak1/data_arena.cpp
