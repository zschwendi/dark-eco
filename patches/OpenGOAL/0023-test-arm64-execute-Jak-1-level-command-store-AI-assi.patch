+  EXPECT_EQ(read_u32(arena.data(), second_node_offset + 0x20), 0u);
+  EXPECT_EQ(read_u32(arena.data(), second_load_commands_offset), kSecondPair);
+  EXPECT_EQ(read_u32(arena.data(), second_node_offset + 0x28), 0u);
