From bd3f4752cea18e73fb1e5cbaec3efdd89ec38195 Mon Sep 17 00:00:00 2001
From: zephyrstudiosllc <zschwendi@zephyrstudios.dev>
Date: Thu, 30 Jul 2026 23:05:07 -0600
Subject: [PATCH] test(arm64): execute generated Jak 1 AOT artifacts
 (AI-assisted)

---
 test/CMakeLists.txt               |  97 +++++++++++++++++++++++++++-
 test/test_arm64_goal_call_abi.cpp | 101 +++++++++++++++++++++++++++---
 2 files changed, 188 insertions(+), 10 deletions(-)

diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
index c8db17dd..3051ed2b 100644
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -48,13 +48,104 @@ endif()
 
 if(BUILD_TESTING AND GOAL_HOST_TESTS_ENABLED AND APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm64")
   enable_language(ASM)
+
+  set(ARM64_GOAL_CALL_AOT_DIR
+      "${CMAKE_CURRENT_BINARY_DIR}/generated-arm64-goal-call")
+  set(ARM64_GOAL_CALL_AOT_SOURCE_DIR
+      "${CMAKE_SOURCE_DIR}/test/goalc/source_templates/arm64-aot")
+  set(ARM64_GOAL_CALL_AOT_FALSE_ASSEMBLY
+      "${ARM64_GOAL_CALL_AOT_DIR}/OpenGOALJak1FalseFunc.s")
+  set(ARM64_GOAL_CALL_AOT_FALSE_EXPORTS
+      "${ARM64_GOAL_CALL_AOT_DIR}/OpenGOALJak1FalseFunc.exports.h")
+  set(ARM64_GOAL_CALL_AOT_TRUE_ASSEMBLY
+      "${ARM64_GOAL_CALL_AOT_DIR}/OpenGOALJak1TrueFunc.s")
+  set(ARM64_GOAL_CALL_AOT_TRUE_EXPORTS
+      "${ARM64_GOAL_CALL_AOT_DIR}/OpenGOALJak1TrueFunc.exports.h")
+  set(ARM64_GOAL_CALL_AOT_IDENTITY_ASSEMBLY
+      "${ARM64_GOAL_CALL_AOT_DIR}/OpenGOALJak1Identity.s")
+  set(ARM64_GOAL_CALL_AOT_IDENTITY_EXPORTS
+      "${ARM64_GOAL_CALL_AOT_DIR}/OpenGOALJak1Identity.exports.h")
+  set(ARM64_GOAL_CALL_AOT_LOGNOT_ASSEMBLY
+      "${ARM64_GOAL_CALL_AOT_DIR}/OpenGOALJak1Lognot.s")
+  set(ARM64_GOAL_CALL_AOT_LOGNOT_EXPORTS
+      "${ARM64_GOAL_CALL_AOT_DIR}/OpenGOALJak1Lognot.exports.h")
+  set(ARM64_GOAL_CALL_AOT_ASSEMBLIES
+      ${ARM64_GOAL_CALL_AOT_FALSE_ASSEMBLY}
+      ${ARM64_GOAL_CALL_AOT_TRUE_ASSEMBLY}
+      ${ARM64_GOAL_CALL_AOT_IDENTITY_ASSEMBLY}
+      ${ARM64_GOAL_CALL_AOT_LOGNOT_ASSEMBLY})
+  set(ARM64_GOAL_CALL_AOT_EXPORTS
+      ${ARM64_GOAL_CALL_AOT_FALSE_EXPORTS}
+      ${ARM64_GOAL_CALL_AOT_TRUE_EXPORTS}
+      ${ARM64_GOAL_CALL_AOT_IDENTITY_EXPORTS}
+      ${ARM64_GOAL_CALL_AOT_LOGNOT_EXPORTS})
+
+  add_custom_command(
+      OUTPUT ${ARM64_GOAL_CALL_AOT_ASSEMBLIES} ${ARM64_GOAL_CALL_AOT_EXPORTS}
+      COMMAND ${CMAKE_COMMAND} -E make_directory "${ARM64_GOAL_CALL_AOT_DIR}"
+      COMMAND $<TARGET_FILE:goalc-aot>
+              --project-path "${CMAKE_SOURCE_DIR}"
+              --input
+              "${ARM64_GOAL_CALL_AOT_SOURCE_DIR}/full-false-func-from-jak1-gcommon.gc"
+              --function false-func
+              --output "${ARM64_GOAL_CALL_AOT_FALSE_ASSEMBLY}"
+              --exports-output "${ARM64_GOAL_CALL_AOT_FALSE_EXPORTS}"
+              --symbol goalpad_aot_false_func
+      COMMAND $<TARGET_FILE:goalc-aot>
+              --project-path "${CMAKE_SOURCE_DIR}"
+              --input
+              "${ARM64_GOAL_CALL_AOT_SOURCE_DIR}/full-true-func-from-jak1-gcommon.gc"
+              --function true-func
+              --output "${ARM64_GOAL_CALL_AOT_TRUE_ASSEMBLY}"
+              --exports-output "${ARM64_GOAL_CALL_AOT_TRUE_EXPORTS}"
+              --symbol goalpad_aot_true_func
+      COMMAND $<TARGET_FILE:goalc-aot>
+              --project-path "${CMAKE_SOURCE_DIR}"
+              --input
+              "${ARM64_GOAL_CALL_AOT_SOURCE_DIR}/full-identity-from-jak1-gcommon.gc"
+              --function identity
+              --output "${ARM64_GOAL_CALL_AOT_IDENTITY_ASSEMBLY}"
+              --exports-output "${ARM64_GOAL_CALL_AOT_IDENTITY_EXPORTS}"
+              --symbol goalpad_aot_identity
+      COMMAND $<TARGET_FILE:goalc-aot>
+              --project-path "${CMAKE_SOURCE_DIR}"
+              --input
+              "${ARM64_GOAL_CALL_AOT_SOURCE_DIR}/full-lognot-from-jak1-gcommon.gc"
+              --function lognot
+              --output "${ARM64_GOAL_CALL_AOT_LOGNOT_ASSEMBLY}"
+              --exports-output "${ARM64_GOAL_CALL_AOT_LOGNOT_EXPORTS}"
+              --symbol goalpad_aot_lognot
+      DEPENDS
+              goalc-aot
+              "${ARM64_GOAL_CALL_AOT_SOURCE_DIR}/full-false-func-from-jak1-gcommon.gc"
+              "${ARM64_GOAL_CALL_AOT_SOURCE_DIR}/full-true-func-from-jak1-gcommon.gc"
+              "${ARM64_GOAL_CALL_AOT_SOURCE_DIR}/full-identity-from-jak1-gcommon.gc"
+              "${ARM64_GOAL_CALL_AOT_SOURCE_DIR}/full-lognot-from-jak1-gcommon.gc"
+      COMMENT "Generating Jak 1 ARM64 AOT call artifacts"
+      VERBATIM)
+
+  add_custom_target(
+      arm64-goal-call-aot-artifacts
+      DEPENDS ${ARM64_GOAL_CALL_AOT_ASSEMBLIES} ${ARM64_GOAL_CALL_AOT_EXPORTS})
+  set_source_files_properties(
+      ${ARM64_GOAL_CALL_AOT_ASSEMBLIES} ${ARM64_GOAL_CALL_AOT_EXPORTS}
+      PROPERTIES GENERATED TRUE)
+  set_source_files_properties(
+      ${ARM64_GOAL_CALL_AOT_EXPORTS}
+      PROPERTIES HEADER_FILE_ONLY TRUE)
+
   add_executable(arm64-goal-call-abi-test
                  ${CMAKE_CURRENT_LIST_DIR}/test_arm64_goal_call_abi.cpp
                  ${CMAKE_CURRENT_LIST_DIR}/test_arm64_goal_call_abi.s
-                 ${CMAKE_SOURCE_DIR}/game/kernel/asm_funcs_arm64.s)
-  target_link_libraries(arm64-goal-call-abi-test gtest_main)
+                 ${CMAKE_SOURCE_DIR}/game/kernel/asm_funcs_arm64.s
+                 ${ARM64_GOAL_CALL_AOT_ASSEMBLIES}
+                 ${ARM64_GOAL_CALL_AOT_EXPORTS})
+  add_dependencies(arm64-goal-call-abi-test arm64-goal-call-aot-artifacts)
+  target_include_directories(arm64-goal-call-abi-test
+                             PRIVATE "${ARM64_GOAL_CALL_AOT_DIR}")
+  target_link_libraries(arm64-goal-call-abi-test jak1-data-arena gtest_main)
   target_compile_features(arm64-goal-call-abi-test PRIVATE cxx_std_20)
-  gtest_discover_tests(arm64-goal-call-abi-test)
+  gtest_discover_tests(arm64-goal-call-abi-test PROPERTIES RUN_SERIAL TRUE)
 endif()
 
 add_executable(test_image_resize ${CMAKE_CURRENT_LIST_DIR}/common/test_image_resize.cpp)
diff --git a/test/test_arm64_goal_call_abi.cpp b/test/test_arm64_goal_call_abi.cpp
index 712cb92f..212d4c8b 100644
--- a/test/test_arm64_goal_call_abi.cpp
+++ b/test/test_arm64_goal_call_abi.cpp
@@ -1,7 +1,10 @@
 #include <array>
 #include <cstddef>
 #include <cstdint>
+#include <string_view>
+#include <vector>
 
+#include "game/kernel/jak1/data_arena.h"
 #include "gtest/gtest.h"
 
 namespace {
@@ -46,6 +49,12 @@ static_assert(offsetof(Arm64GoalCallProbe, caller_x22_after) == 120);
 extern "C" void arm64_goal_call_abi_outer(Arm64GoalCallProbe* probe);
 using Arm64GoalEntry =
     std::uint64_t (*)(std::uint64_t, std::uint64_t, std::uint64_t);
+using Arm64GoalExport0Entry = std::uint64_t (*)();
+using Arm64GoalExport1Entry = std::uint64_t (*)(std::uint64_t);
+
+static_assert(sizeof(Arm64GoalEntry) == sizeof(std::uintptr_t));
+static_assert(sizeof(Arm64GoalExport0Entry) == sizeof(std::uintptr_t));
+static_assert(sizeof(Arm64GoalExport1Entry) == sizeof(std::uintptr_t));
 
 extern "C" std::uint64_t arm64_goal_call_abi_entry(std::uint64_t,
                                                     std::uint64_t,
@@ -54,7 +63,48 @@ extern "C" std::uint64_t arm64_goal_call_false_like_entry(std::uint64_t,
                                                            std::uint64_t,
                                                            std::uint64_t);
 
-std::uintptr_t entry_address(Arm64GoalEntry entry) {
+#define OPENGOAL_AOT_EXPORT0(goal_name, c_symbol) \
+  extern "C" std::uint64_t c_symbol();
+#include "OpenGOALJak1FalseFunc.exports.h"
+#include "OpenGOALJak1TrueFunc.exports.h"
+#undef OPENGOAL_AOT_EXPORT0
+
+#define OPENGOAL_AOT_EXPORT1(goal_name, c_symbol) \
+  extern "C" std::uint64_t c_symbol(std::uint64_t);
+#include "OpenGOALJak1Identity.exports.h"
+#include "OpenGOALJak1Lognot.exports.h"
+#undef OPENGOAL_AOT_EXPORT1
+
+struct Arm64GoalExport0 {
+  std::string_view goal_name;
+  Arm64GoalExport0Entry entry;
+};
+
+struct Arm64GoalExport1 {
+  std::string_view goal_name;
+  Arm64GoalExport1Entry entry;
+};
+
+constexpr Arm64GoalExport0 kArm64GoalExports0[] = {
+#define OPENGOAL_AOT_EXPORT0(goal_name, c_symbol) {goal_name, &c_symbol},
+#include "OpenGOALJak1FalseFunc.exports.h"
+#include "OpenGOALJak1TrueFunc.exports.h"
+#undef OPENGOAL_AOT_EXPORT0
+};
+
+constexpr Arm64GoalExport1 kArm64GoalExports1[] = {
+#define OPENGOAL_AOT_EXPORT1(goal_name, c_symbol) {goal_name, &c_symbol},
+#include "OpenGOALJak1Identity.exports.h"
+#include "OpenGOALJak1Lognot.exports.h"
+#undef OPENGOAL_AOT_EXPORT1
+};
+
+static_assert(sizeof(kArm64GoalExports0) == 2 * sizeof(Arm64GoalExport0));
+static_assert(sizeof(kArm64GoalExports1) == 2 * sizeof(Arm64GoalExport1));
+
+template <typename Entry>
+std::uintptr_t entry_address(Entry entry) {
+  static_assert(sizeof(Entry) == sizeof(std::uintptr_t));
   return reinterpret_cast<std::uintptr_t>(entry);
 }
 
@@ -68,6 +118,12 @@ Arm64GoalCallProbe make_probe(std::uintptr_t entry, std::uintptr_t st, std::uint
   };
 }
 
+void expect_caller_registers_restored(const Arm64GoalCallProbe& probe) {
+  EXPECT_EQ(probe.caller_x20_after, 0x14);
+  EXPECT_EQ(probe.caller_x21_after, 0x15);
+  EXPECT_EQ(probe.caller_x22_after, 0x16);
+}
+
 TEST(Arm64GoalCallAbi, forwards_goal_register_context_and_restores_caller_registers) {
   std::array<std::byte, 64> arena{};
   constexpr std::uintptr_t kSt = 0x14fd24;
@@ -84,9 +140,7 @@ TEST(Arm64GoalCallAbi, forwards_goal_register_context_and_restores_caller_regist
   EXPECT_EQ(probe.entry_x22, reinterpret_cast<std::uintptr_t>(arena.data()));
   EXPECT_EQ(probe.entry_sp_mod16, 0);
   EXPECT_EQ(probe.result, probe.argument0 ^ probe.argument1);
-  EXPECT_EQ(probe.caller_x20_after, 0x14);
-  EXPECT_EQ(probe.caller_x21_after, 0x15);
-  EXPECT_EQ(probe.caller_x22_after, 0x16);
+  expect_caller_registers_restored(probe);
 }
 
 TEST(Arm64GoalCallAbi, calls_a_static_false_like_entry_with_the_symbol_table_register) {
@@ -98,9 +152,42 @@ TEST(Arm64GoalCallAbi, calls_a_static_false_like_entry_with_the_symbol_table_reg
   arm64_goal_call_abi_outer(&probe);
 
   EXPECT_EQ(probe.result, kSt);
-  EXPECT_EQ(probe.caller_x20_after, 0x14);
-  EXPECT_EQ(probe.caller_x21_after, 0x15);
-  EXPECT_EQ(probe.caller_x22_after, 0x16);
+  expect_caller_registers_restored(probe);
+}
+
+TEST(Arm64GoalCallAbi, executes_generated_jak1_aot_artifacts_against_one_data_arena) {
+  std::vector<std::byte> arena(jak1::minimum_data_arena_header_size());
+  const auto initialized = jak1::initialize_data_arena_header(arena.data(), arena.size());
+  ASSERT_TRUE(initialized.ok());
+
+  ASSERT_EQ(kArm64GoalExports0[0].goal_name, "false-func");
+  ASSERT_EQ(kArm64GoalExports0[1].goal_name, "true-func");
+  ASSERT_EQ(kArm64GoalExports1[0].goal_name, "identity");
+  ASSERT_EQ(kArm64GoalExports1[1].goal_name, "lognot");
+  ASSERT_NE(kArm64GoalExports0[0].entry, nullptr);
+  ASSERT_NE(kArm64GoalExports0[1].entry, nullptr);
+  ASSERT_NE(kArm64GoalExports1[0].entry, nullptr);
+  ASSERT_NE(kArm64GoalExports1[1].entry, nullptr);
+
+  const auto st = static_cast<std::uintptr_t>(initialized.header.s7);
+  const auto arena_address = reinterpret_cast<std::uintptr_t>(arena.data());
+  auto invoke = [&](auto entry) {
+    auto probe = make_probe(entry_address(entry), st, arena_address);
+    arm64_goal_call_abi_outer(&probe);
+    expect_caller_registers_restored(probe);
+    return probe;
+  };
+
+  const auto false_probe = invoke(kArm64GoalExports0[0].entry);
+  const auto true_probe = invoke(kArm64GoalExports0[1].entry);
+  const auto identity_probe = invoke(kArm64GoalExports1[0].entry);
+  const auto lognot_probe = invoke(kArm64GoalExports1[1].entry);
+
+  EXPECT_EQ(false_probe.result, initialized.header.false_value);
+  EXPECT_EQ(true_probe.result, initialized.header.true_value);
+  EXPECT_NE(identity_probe.argument0, 0);
+  EXPECT_EQ(identity_probe.result, identity_probe.argument0);
+  EXPECT_EQ(lognot_probe.result, ~lognot_probe.argument0);
 }
 
 }  // namespace
-- 
