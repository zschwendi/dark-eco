From d3492375caf8de14815133c3597eb65efb44bca2 Mon Sep 17 00:00:00 2001
From: zephyrstudiosllc <zschwendi@zephyrstudios.dev>
Date: Fri, 31 Jul 2026 01:12:03 -0600
Subject: [PATCH] test(arm64): preserve want-vis inline layout (AI-assisted)

---
 .../full-want-vis-from-jak1-load-boundary.gc     |  3 ++-
 test/goalc/test_arm64_aot.cpp                    | 16 +++++++++++++++-
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/test/goalc/source_templates/arm64-aot/full-want-vis-from-jak1-load-boundary.gc b/test/goalc/source_templates/arm64-aot/full-want-vis-from-jak1-load-boundary.gc
index 78ca4f12..a13f7ffa 100644
--- a/test/goalc/source_templates/arm64-aot/full-want-vis-from-jak1-load-boundary.gc
+++ b/test/goalc/source_templates/arm64-aot/full-want-vis-from-jak1-load-boundary.gc
@@ -8,13 +8,14 @@
    (display? symbol)
    (force-vis? symbol)
    (force-inside? symbol))
+  :pack-me
   :size-assert #x10
   :no-runtime-type
   :no-inspect)
 
 (deftype load-state (basic)
   ((want level-buffer-state 2 :inline)
-   (vis-nick symbol :offset #x24 :offset-assert #x24))
+   (vis-nick symbol :offset-assert #x24))
   :no-runtime-type
   :no-inspect)
 
diff --git a/test/goalc/test_arm64_aot.cpp b/test/goalc/test_arm64_aot.cpp
index d6c3cbb0..dea93854 100644
--- a/test/goalc/test_arm64_aot.cpp
+++ b/test/goalc/test_arm64_aot.cpp
@@ -757,7 +757,7 @@ TEST(Arm64Aot, rejects_want_vis_with_a_different_field_offset) {
   Compiler compiler(GameVersion::Jak1, emitter::InstructionSet::ARM64);
   auto source = file_util::read_text_file(file_util::get_file_path(
       {"test/goalc/source_templates/arm64-aot/full-want-vis-from-jak1-load-boundary.gc"}));
-  const std::string expected_field = "(vis-nick symbol :offset #x24 :offset-assert #x24)";
+  const std::string expected_field = "(vis-nick symbol :offset-assert #x24)";
   const auto field_position = source.find(expected_field);
   ASSERT_NE(field_position, std::string::npos);
   source.replace(field_position, expected_field.size(),
@@ -768,6 +768,20 @@ TEST(Arm64Aot, rejects_want_vis_with_a_different_field_offset) {
                std::runtime_error);
 }
 
+TEST(Arm64Aot, rejects_want_vis_with_an_unpacked_inline_layout) {
+  Compiler compiler(GameVersion::Jak1, emitter::InstructionSet::ARM64);
+  auto source = file_util::read_text_file(file_util::get_file_path(
+      {"test/goalc/source_templates/arm64-aot/full-want-vis-from-jak1-load-boundary.gc"}));
+  const std::string expected_packing = "  :pack-me\n";
+  const auto packing_position = source.find(expected_packing);
+  ASSERT_NE(packing_position, std::string::npos);
+  source.erase(packing_position, expected_packing.size());
+
+  EXPECT_THROW(compiler.compile_arm64_aot_source(source, "want-vis-with-unpacked-inline-layout",
+                                                 std::optional<std::string>{"want-vis"}),
+               std::runtime_error);
+}
+
 TEST(Arm64Aot, rejects_want_vis_with_a_non_symbol_value) {
   Compiler compiler(GameVersion::Jak1, emitter::InstructionSet::ARM64);
   auto source = file_util::read_text_file(file_util::get_file_path(
