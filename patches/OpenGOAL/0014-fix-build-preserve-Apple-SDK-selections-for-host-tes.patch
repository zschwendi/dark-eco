From b094144b27af99abd2e3b6809e8f58f93d0fb15a Mon Sep 17 00:00:00 2001
From: zephyrstudiosllc <zschwendi@zephyrstudios.dev>
Date: Thu, 30 Jul 2026 21:36:35 -0600
Subject: [PATCH 14/15] fix(build): preserve Apple SDK selections for host
 tests (AI-assisted)

Keep a caller-selected Apple sysroot intact and register the data-arena test only for runnable host configurations.
---
 CMakeLists.txt      | 29 ++++++++++++++++++++++-------
 test/CMakeLists.txt |  8 +++++---
 2 files changed, 27 insertions(+), 10 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f6ddddf9..deec4fc4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,13 +39,28 @@ endif()
 # a more recent issue - https://github.com/libsdl-org/SDL/issues/12078
 if (APPLE)
   enable_language(OBJC)
-  execute_process(
-    COMMAND xcrun --show-sdk-path
-        OUTPUT_VARIABLE MACOSX_SYSROOT
-        OUTPUT_STRIP_TRAILING_WHITESPACE
-    )
-    # Tell CMake to use it
-    set(CMAKE_OSX_SYSROOT "${MACOSX_SYSROOT}" CACHE PATH "macOS SDK path" FORCE)
+  if(NOT CMAKE_OSX_SYSROOT)
+    execute_process(
+      COMMAND xcrun --show-sdk-path
+          OUTPUT_VARIABLE MACOSX_SYSROOT
+          OUTPUT_STRIP_TRAILING_WHITESPACE
+      )
+      # Tell CMake to use the host SDK unless a caller selected an Apple platform SDK.
+      set(CMAKE_OSX_SYSROOT "${MACOSX_SYSROOT}" CACHE PATH "macOS SDK path" FORCE)
+  endif()
+endif()
+
+# Cross-compiled test executables cannot be discovered or run on the host. The explicit sysroot
+# check also covers non-macOS Apple SDK selections that do not set CMAKE_CROSSCOMPILING.
+set(GOAL_HOST_TESTS_ENABLED OFF)
+if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
+  set(GOAL_HOST_TESTS_ENABLED ON)
+  if(APPLE)
+    string(TOLOWER "${CMAKE_OSX_SYSROOT}" GOAL_APPLE_SYSROOT)
+    if(NOT GOAL_APPLE_SYSROOT MATCHES "macosx")
+      set(GOAL_HOST_TESTS_ENABLED OFF)
+    endif()
+  endif()
 endif()
 
 # Setup compiler flags
diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
index 84fa279c..c982f0d7 100644
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -40,9 +40,11 @@ add_executable(goalc-test
 
 target_link_libraries(goalc-test common runtime compiler gtest decomp Zydis libzstd_static tree-sitter)
 
-add_executable(jak1-data-arena-test ${CMAKE_CURRENT_LIST_DIR}/test_jak1_data_arena.cpp)
-target_link_libraries(jak1-data-arena-test jak1-data-arena gtest_main)
-gtest_discover_tests(jak1-data-arena-test)
+if(BUILD_TESTING AND GOAL_HOST_TESTS_ENABLED)
+  add_executable(jak1-data-arena-test ${CMAKE_CURRENT_LIST_DIR}/test_jak1_data_arena.cpp)
+  target_link_libraries(jak1-data-arena-test jak1-data-arena gtest_main)
+  gtest_discover_tests(jak1-data-arena-test)
+endif()
 
 add_executable(test_image_resize ${CMAKE_CURRENT_LIST_DIR}/common/test_image_resize.cpp)
 target_link_libraries(test_image_resize common)
