From 5495181f304bb63b49a82e9067d59fd27a5dd6c8 Mon Sep 17 00:00:00 2001
From: zephyrstudiosllc <zschwendi@zephyrstudios.dev>
Date: Thu, 30 Jul 2026 21:47:16 -0600
Subject: [PATCH 15/15] fix(kernel): preserve canonical Jak 1 data arena bounds
 (AI-assisted)

Require the canonical GOAL range, clear only that range, and cover exact-size and unaligned caller storage.
---
 game/kernel/jak1/data_arena.cpp | 17 +++---
 game/kernel/jak1/data_arena.h   | 18 ++++--
 test/test_jak1_data_arena.cpp   | 99 ++++++++++++++++++++-------------
 3 files changed, 82 insertions(+), 52 deletions(-)

diff --git a/game/kernel/jak1/data_arena.cpp b/game/kernel/jak1/data_arena.cpp
index 9613bc93..550a0f57 100644
--- a/game/kernel/jak1/data_arena.cpp
+++ b/game/kernel/jak1/data_arena.cpp
@@ -6,6 +6,7 @@
 
 #include "common/goal_constants.h"
 #include "common/symbols.h"
+
 #include "game/kernel/common/kmalloc.h"
 #include "game/kernel/common/memory_layout.h"
 #include "game/kernel/jak1/kscheme.h"
@@ -16,6 +17,7 @@ namespace {
 constexpr std::uint32_t kSymbolTableEntrySize = 8;
 constexpr std::uint32_t kSymbolTableOffset = HEAP_START;
 constexpr std::uint32_t kSymbolTableEnd = kSymbolTableOffset + SYM_TABLE_MEM_SIZE;
+constexpr std::uint32_t kGlobalHeapEnd = GLOBAL_HEAP_END;
 constexpr std::uint32_t kS7 =
     kSymbolTableOffset + (GOAL_MAX_SYMBOLS / 2) * kSymbolTableEntrySize + BASIC_OFFSET;
 constexpr std::uint32_t kSymbolTable2 = kSymbolTableOffset + BASIC_OFFSET;
@@ -29,7 +31,8 @@ static_assert(offsetof(kheapinfo, current) == 2 * sizeof(std::uint32_t));
 static_assert(offsetof(kheapinfo, top_base) == 3 * sizeof(std::uint32_t));
 static_assert(sizeof(Symbol) == sizeof(std::uint32_t));
 static_assert(offsetof(Symbol, value) == 0);
-static_assert(kSymbolTableEnd == minimum_data_arena_header_size());
+static_assert(kGlobalHeapEnd == minimum_data_arena_header_size());
+static_assert(kSymbolTableEnd <= kGlobalHeapEnd);
 static_assert(kSymbolTableOffset >= GLOBAL_HEAP_INFO_ADDR + sizeof(kheapinfo));
 
 void write_u32(std::byte* storage, std::size_t offset, std::uint32_t value) {
@@ -49,19 +52,17 @@ DataArenaHeaderResult initialize_data_arena_header(std::byte* storage, std::size
     return {.error = DataArenaHeaderError::StorageTooLarge};
   }
 
-  const auto heap_end = static_cast<std::uint32_t>(storage_size);
-  std::memset(storage, 0, storage_size);
+  std::memset(storage, 0, kGlobalHeapEnd);
 
   write_u32(storage, GLOBAL_HEAP_INFO_ADDR + offsetof(kheapinfo, base), HEAP_START);
-  write_u32(storage, GLOBAL_HEAP_INFO_ADDR + offsetof(kheapinfo, top), heap_end);
+  write_u32(storage, GLOBAL_HEAP_INFO_ADDR + offsetof(kheapinfo, top), kGlobalHeapEnd);
   write_u32(storage, GLOBAL_HEAP_INFO_ADDR + offsetof(kheapinfo, current), kSymbolTableEnd);
-  write_u32(storage, GLOBAL_HEAP_INFO_ADDR + offsetof(kheapinfo, top_base), heap_end);
+  write_u32(storage, GLOBAL_HEAP_INFO_ADDR + offsetof(kheapinfo, top_base), kGlobalHeapEnd);
 
   write_u32(storage, kS7 + jak1_symbols::FIX_SYM_EMPTY_CAR, kEmptyPair);
   write_u32(storage, kS7 + jak1_symbols::FIX_SYM_EMPTY_CDR, kEmptyPair);
   write_u32(storage, kS7 + jak1_symbols::FIX_SYM_FALSE, kS7);
-  write_u32(storage, kS7 + jak1_symbols::FIX_SYM_TRUE,
-            kS7 + jak1_symbols::FIX_SYM_TRUE);
+  write_u32(storage, kS7 + jak1_symbols::FIX_SYM_TRUE, kS7 + jak1_symbols::FIX_SYM_TRUE);
   write_u32(storage, kS7 + jak1_symbols::FIX_SYM_GLOBAL_HEAP, GLOBAL_HEAP_INFO_ADDR);
 
   return {
@@ -70,7 +71,7 @@ DataArenaHeaderResult initialize_data_arena_header(std::byte* storage, std::size
               .global_heap_info = GLOBAL_HEAP_INFO_ADDR,
               .global_heap_base = HEAP_START,
               .global_heap_current = kSymbolTableEnd,
-              .global_heap_end = heap_end,
+              .global_heap_end = kGlobalHeapEnd,
               .symbol_table = kSymbolTableOffset,
               .symbol_table_end = kSymbolTableEnd,
               .symbol_table2 = kSymbolTable2,
diff --git a/game/kernel/jak1/data_arena.h b/game/kernel/jak1/data_arena.h
index aebfea1e..753e0e94 100644
--- a/game/kernel/jak1/data_arena.h
+++ b/game/kernel/jak1/data_arena.h
@@ -4,6 +4,7 @@
 #include <cstdint>
 
 #include "common/goal_constants.h"
+
 #include "game/kernel/common/memory_layout.h"
 
 namespace jak1 {
@@ -38,17 +39,24 @@ struct DataArenaHeaderResult {
 };
 
 [[nodiscard]] constexpr std::size_t minimum_data_arena_header_size() {
-  return static_cast<std::size_t>(HEAP_START) + static_cast<std::size_t>(SYM_TABLE_MEM_SIZE);
+  return static_cast<std::size_t>(GLOBAL_HEAP_END);
 }
 
 /*!
  * Initialize the data-only prefix of Jak 1's GOAL memory layout in caller-owned storage.
  *
- * This establishes the global heap record, symbol table extent, fixed #f/#t value cells, and
- * empty pair representation. It neither binds the storage to g_ee_main_mem nor creates GOAL
- * code, native-function trampolines, symbol metadata, type objects, or linked game data.
+ * Storage represents zero-based GOAL offsets and must provide at least GLOBAL_HEAP_END bytes.
+ * Successful initialization clears only [storage, storage + GLOBAL_HEAP_END). The global heap
+ * record uses the base and bounds configured by InitMachine; the current pointer is the end of
+ * the initial symbol-table allocation. It also stages the symbol table extent, fixed #f/#t
+ * value cells, and empty pair representation. Callers must treat that range as destructively
+ * initialized; bytes beyond it are left untouched.
+ *
+ * This is a partial data-only bootstrap, not a complete InitHeapAndSymbol snapshot. It neither
+ * binds the storage to g_ee_main_mem nor creates GOAL code, native-function trampolines, symbol
+ * metadata, type objects, or linked game data.
  */
 [[nodiscard]] DataArenaHeaderResult initialize_data_arena_header(std::byte* storage,
-                                                                   std::size_t storage_size);
+                                                                 std::size_t storage_size);
 
 }  // namespace jak1
