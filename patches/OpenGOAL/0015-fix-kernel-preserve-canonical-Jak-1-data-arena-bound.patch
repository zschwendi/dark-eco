   std::vector<std::byte> storage(kGuardSize + kArenaSize + kGuardSize, std::byte{0xa5});
   auto* arena = storage.data() + kGuardSize;
 
@@ -40,7 +44,7 @@ TEST(Jak1DataArena, InitializesExactDataOnlyHeader) {
