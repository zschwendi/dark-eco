+if(NOT ACTUAL_WANT_VIS_ASSEMBLY STREQUAL EXPECTED_WANT_VIS_ASSEMBLY)
+  message(FATAL_ERROR "Assembly-only want-vis artifact did not match the expected ARM64 code")
+endif()
+
+execute_process(
+  COMMAND "${GOALC_AOT}"
