#include "Jak2Dev-Debug.xcconfig"

GOALPAD_HAS_JAK2_IMPORT_COMPOSER = 0
GOALPAD_HAS_JAK2_IMPORT_COMPOSER[sdk=iphoneos*] = 1
GOALPAD_HAS_JAK2_IMPORT_COMPOSER[sdk=iphonesimulator*] = 1

GOALPAD_OPENGOAL_PHASE_INPUT = $(GOALPAD_OPENGOAL_ROOT)
GOALPAD_OPENGOAL_GITFILE_PHASE_INPUT = $(GOALPAD_OPENGOAL_ROOT)/.git
GOALPAD_OPENGOAL_GIT_METADATA_PHASE_INPUT = $(GOALPAD_OPENGOAL_GIT_METADATA)
GOALPAD_JAK2_SOURCE_OBJECT_PACK_PHASE_INPUT = $(GOALPAD_JAK2_SOURCE_OBJECT_PACK_ROOT)
GOALPAD_JAK2_IMPORT_BUILD_ROOT_PHASE_INPUT = $(GOALPAD_JAK2_IMPORT_BUILD_ROOT)
GOALPAD_JAK2_IMPORT_ARCHIVE_PHASE_INPUT = $(GOALPAD_JAK2_IMPORT_ARCHIVE)
GOALPAD_JAK2_SOURCE_OBJECT_PACK_VERIFIER_PHASE_INPUT = $(GOALPAD_JAK2_SOURCE_OBJECT_PACK_VERIFIER)

OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) "$(GOALPAD_JAK2_IMPORT_ARCHIVE)"
OTHER_LDFLAGS[sdk=iphonesimulator*] = $(inherited) "$(GOALPAD_JAK2_IMPORT_ARCHIVE)"
