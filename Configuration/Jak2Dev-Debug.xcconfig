GOALPAD_HAS_JAK1_IMPORT_COMPOSER = 0
GOALPAD_HAS_JAK2_IMPORT_COMPOSER = 0

GOALPAD_OPENGOAL_ROOT = $(SRCROOT)/OpenGOAL
GOALPAD_OPENGOAL_GIT_METADATA = $(SRCROOT)/OpenGOAL/.git
GOALPAD_JAK2_SOURCE_OBJECT_PACK_ROOT = $(SRCROOT)/build/jak2-source-object-pack
GOALPAD_JAK2_IMPORT_BUILD_ROOT = $(DERIVED_FILE_DIR)/Jak2ImportComposer
GOALPAD_JAK2_IMPORT_ARCHIVE = $(DERIVED_FILE_DIR)/Jak2ImportComposer/$(PLATFORM_NAME)/jak2-import-composer-apple/libjak2-import-composer-apple.a
GOALPAD_JAK2_SOURCE_OBJECT_PACK_VERIFIER = $(DERIVED_FILE_DIR)/Jak2ImportComposer/macosx-host/jak2-source-object-pack-verify
GOALPAD_JAK2_SOURCE_OBJECT_PACK_VERIFIER[sdk=macosx*] = $(DERIVED_FILE_DIR)/Jak2ImportComposer/macosx/jak2-source-object-pack-verify
GOALPAD_APP_RESOURCE_DESTINATION = $(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)
GOALPAD_JAK2_PROJECT_RESOURCES = $(GOALPAD_APP_RESOURCE_DESTINATION)/Jak2ProjectResources
GOALPAD_JAK2_SOURCE_OBJECT_PACK_RESOURCES = $(GOALPAD_APP_RESOURCE_DESTINATION)/Jak2SourceObjectPack

GOALPAD_OPENGOAL_PHASE_INPUT = $(SRCROOT)
GOALPAD_OPENGOAL_GITFILE_PHASE_INPUT = $(SRCROOT)/.git
GOALPAD_OPENGOAL_GIT_METADATA_PHASE_INPUT = $(SRCROOT)/.git
GOALPAD_JAK2_SOURCE_OBJECT_PACK_PHASE_INPUT = $(SRCROOT)/Scripts/build-jak2-import-composer-apple.sh
GOALPAD_JAK2_IMPORT_BUILD_ROOT_PHASE_INPUT = $(SRCROOT)/Scripts/build-jak2-import-composer-apple.sh
GOALPAD_JAK2_IMPORT_ARCHIVE_PHASE_INPUT = $(SRCROOT)/Scripts/build-jak2-import-composer-apple.sh
GOALPAD_JAK2_SOURCE_OBJECT_PACK_VERIFIER_PHASE_INPUT = $(SRCROOT)/Scripts/build-jak2-import-composer-apple.sh

GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET =
GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET[sdk=macosx*] = $(MACOSX_DEPLOYMENT_TARGET)
GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET[sdk=iphoneos*] = $(IPHONEOS_DEPLOYMENT_TARGET)
GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET[sdk=iphonesimulator*] = $(IPHONEOS_DEPLOYMENT_TARGET)
GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET[sdk=xros*] = $(XROS_DEPLOYMENT_TARGET)
GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET[sdk=xrsimulator*] = $(XROS_DEPLOYMENT_TARGET)

GOALPAD_JAK2_NATIVE_BUILD_ROOT = $(DERIVED_FILE_DIR)/Jak2Native/$(PLATFORM_NAME)
GOALPAD_JAK2_NATIVE_CONFIG_DIR = $(GOALPAD_JAK2_NATIVE_BUILD_ROOT)/$(CONFIGURATION)-$(PLATFORM_NAME)
GOALPAD_JAK2_ZSTD_CONFIG_DIR = $(GOALPAD_JAK2_NATIVE_BUILD_ROOT)/third-party/zstd/$(CONFIGURATION)-$(PLATFORM_NAME)

ENABLE_USER_SCRIPT_SANDBOXING = NO
ARCHS = arm64

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) FMT_HEADER_ONLY=1 GOALPAD_SND_NO_CUBEB=1 GOALPAD_JAK2=1 GOALPAD_HAS_JAK1_IMPORT_COMPOSER=$(GOALPAD_HAS_JAK1_IMPORT_COMPOSER) GOALPAD_HAS_JAK2_IMPORT_COMPOSER=$(GOALPAD_HAS_JAK2_IMPORT_COMPOSER)
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) GOALPAD_JAK2

OTHER_LDFLAGS = $(inherited) "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libopengoal-jak2-runtime.a" "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libjak2-iphoneos-metal-host.a" "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libopengoal-jak2-aot-corpus.a" "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libjak2-iphoneos-metal-product.a" "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libjak2-kernel-core.a" "$(GOALPAD_JAK2_ZSTD_CONFIG_DIR)/liblibzstd_static.a" -framework Metal -framework QuartzCore -framework Foundation -lobjc
