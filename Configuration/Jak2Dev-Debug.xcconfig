GOALPAD_HAS_JAK1_IMPORT_COMPOSER = 0
GOALPAD_JAK2_NATIVE_BUILD_ROOT = $(DERIVED_FILE_DIR)/Jak2Native/$(PLATFORM_NAME)
GOALPAD_JAK2_NATIVE_CONFIG_DIR = $(GOALPAD_JAK2_NATIVE_BUILD_ROOT)/$(CONFIGURATION)-$(PLATFORM_NAME)
GOALPAD_JAK2_ZSTD_CONFIG_DIR = $(GOALPAD_JAK2_NATIVE_BUILD_ROOT)/third-party/zstd/$(CONFIGURATION)-$(PLATFORM_NAME)

ENABLE_USER_SCRIPT_SANDBOXING = NO
ARCHS = arm64

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) FMT_HEADER_ONLY=1 GOALPAD_SND_NO_CUBEB=1 GOALPAD_JAK2=1 GOALPAD_HAS_JAK1_IMPORT_COMPOSER=0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) GOALPAD_JAK2

OTHER_LDFLAGS = $(inherited) "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libopengoal-jak2-runtime.a" "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libjak2-iphoneos-metal-host.a" "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libopengoal-jak2-aot-corpus.a" "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libjak2-iphoneos-metal-product.a" "$(GOALPAD_JAK2_NATIVE_CONFIG_DIR)/libjak2-kernel-core.a" "$(GOALPAD_JAK2_ZSTD_CONFIG_DIR)/liblibzstd_static.a" -framework Metal -framework QuartzCore -framework Foundation -lobjc
