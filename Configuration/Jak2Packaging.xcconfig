GOALPAD_OPENGOAL_ROOT = $(SRCROOT)/OpenGOAL
GOALPAD_OPENGOAL_GIT_METADATA = $(SRCROOT)/OpenGOAL/.git
GOALPAD_JAK2_SOURCE_OBJECT_PACK_ROOT = $(SRCROOT)/build/jak2-source-object-pack
GOALPAD_JAK2_IMPORT_BUILD_ROOT = $(BUILD_DIR)/Jak2ImportComposer
GOALPAD_JAK2_IMPORT_ARCHIVE = $(GOALPAD_JAK2_IMPORT_BUILD_ROOT)/$(PLATFORM_NAME)/jak2-import-composer-apple/libjak2-import-composer-apple.a
GOALPAD_JAK2_SOURCE_OBJECT_PACK_VERIFIER = $(GOALPAD_JAK2_IMPORT_BUILD_ROOT)/macosx-host/jak2-source-object-pack-verify
GOALPAD_APP_RESOURCE_DESTINATION = $(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)
GOALPAD_JAK2_PROJECT_RESOURCES = $(GOALPAD_APP_RESOURCE_DESTINATION)/Jak2ProjectResources
GOALPAD_JAK2_SOURCE_OBJECT_PACK_RESOURCES = $(GOALPAD_APP_RESOURCE_DESTINATION)/Jak2SourceObjectPack

GOALPAD_OPENGOAL_PHASE_INPUT = $(GOALPAD_OPENGOAL_ROOT)
GOALPAD_OPENGOAL_GITFILE_PHASE_INPUT = $(GOALPAD_OPENGOAL_ROOT)/.git
GOALPAD_OPENGOAL_GIT_METADATA_PHASE_INPUT = $(GOALPAD_OPENGOAL_GIT_METADATA)
GOALPAD_JAK2_SOURCE_OBJECT_PACK_PHASE_INPUT = $(GOALPAD_JAK2_SOURCE_OBJECT_PACK_ROOT)
GOALPAD_JAK2_IMPORT_BUILD_ROOT_PHASE_INPUT = $(GOALPAD_JAK2_IMPORT_BUILD_ROOT)
GOALPAD_JAK2_IMPORT_ARCHIVE_PHASE_INPUT = $(GOALPAD_JAK2_IMPORT_ARCHIVE)
GOALPAD_JAK2_SOURCE_OBJECT_PACK_VERIFIER_PHASE_INPUT = $(GOALPAD_JAK2_SOURCE_OBJECT_PACK_VERIFIER)

GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET = $(IPHONEOS_DEPLOYMENT_TARGET)
GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET[sdk=xros*] = $(XROS_DEPLOYMENT_TARGET)
GOALPAD_JAK2_IMPORT_DEPLOYMENT_TARGET[sdk=xrsimulator*] = $(XROS_DEPLOYMENT_TARGET)
