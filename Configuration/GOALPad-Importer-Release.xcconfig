ARCHS = arm64

GOALPAD_HAS_JAK1_IMPORT_COMPOSER = 0
GOALPAD_HAS_JAK1_IMPORT_COMPOSER[sdk=macosx*] = 1
GOALPAD_HAS_JAK1_IMPORT_COMPOSER[sdk=iphoneos*] = 1
GOALPAD_HAS_JAK1_IMPORT_COMPOSER[sdk=iphonesimulator*] = 1
GOALPAD_HAS_JAK1_IMPORT_COMPOSER[sdk=xros*] = 1
GOALPAD_HAS_JAK1_IMPORT_COMPOSER[sdk=xrsimulator*] = 1

GOALPAD_OPENGOAL_ROOT = $(SRCROOT)/OpenGOAL
GOALPAD_OPENGOAL_GIT_METADATA = $(SRCROOT)/.git/modules/OpenGOAL
GOALPAD_JAK1_SOURCE_OBJECT_PACK_ROOT = $(SRCROOT)/build/jak1-source-object-pack
GOALPAD_JAK1_IMPORT_BUILD_ROOT = $(DERIVED_FILE_DIR)/Jak1ImportComposer
GOALPAD_JAK1_IMPORT_ARCHIVE = $(DERIVED_FILE_DIR)/Jak1ImportComposer/$(PLATFORM_NAME)/jak1-import-composer-apple/libjak1-import-composer-apple.a
GOALPAD_JAK1_SOURCE_OBJECT_PACK_VERIFIER = $(DERIVED_FILE_DIR)/Jak1ImportComposer/macosx-host/jak1-source-object-pack-verify
GOALPAD_JAK1_SOURCE_OBJECT_PACK_VERIFIER[sdk=macosx*] = $(DERIVED_FILE_DIR)/Jak1ImportComposer/macosx/jak1-source-object-pack-verify
GOALPAD_APP_RESOURCE_DESTINATION = $(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)
GOALPAD_JAK1_PROJECT_RESOURCES = $(GOALPAD_APP_RESOURCE_DESTINATION)/OpenGOALProjectResources
GOALPAD_JAK1_SOURCE_OBJECT_PACK_RESOURCES = $(GOALPAD_APP_RESOURCE_DESTINATION)/Jak1SourceObjectPack

GOALPAD_OPENGOAL_PHASE_INPUT = $(GOALPAD_OPENGOAL_ROOT)
GOALPAD_OPENGOAL_GITFILE_PHASE_INPUT = $(GOALPAD_OPENGOAL_ROOT)/.git
GOALPAD_OPENGOAL_GIT_METADATA_PHASE_INPUT = $(GOALPAD_OPENGOAL_GIT_METADATA)
GOALPAD_JAK1_SOURCE_OBJECT_PACK_PHASE_INPUT = $(GOALPAD_JAK1_SOURCE_OBJECT_PACK_ROOT)
GOALPAD_JAK1_IMPORT_BUILD_ROOT_PHASE_INPUT = $(GOALPAD_JAK1_IMPORT_BUILD_ROOT)
GOALPAD_JAK1_IMPORT_ARCHIVE_PHASE_INPUT = $(GOALPAD_JAK1_IMPORT_ARCHIVE)
GOALPAD_JAK1_SOURCE_OBJECT_PACK_VERIFIER_PHASE_INPUT = $(GOALPAD_JAK1_SOURCE_OBJECT_PACK_VERIFIER)

GOALPAD_JAK1_IMPORT_DEPLOYMENT_TARGET =
GOALPAD_JAK1_IMPORT_DEPLOYMENT_TARGET[sdk=macosx*] = $(MACOSX_DEPLOYMENT_TARGET)
GOALPAD_JAK1_IMPORT_DEPLOYMENT_TARGET[sdk=iphoneos*] = $(IPHONEOS_DEPLOYMENT_TARGET)
GOALPAD_JAK1_IMPORT_DEPLOYMENT_TARGET[sdk=iphonesimulator*] = $(IPHONEOS_DEPLOYMENT_TARGET)
GOALPAD_JAK1_IMPORT_DEPLOYMENT_TARGET[sdk=xros*] = $(XROS_DEPLOYMENT_TARGET)
GOALPAD_JAK1_IMPORT_DEPLOYMENT_TARGET[sdk=xrsimulator*] = $(XROS_DEPLOYMENT_TARGET)

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) GOALPAD_HAS_JAK1_IMPORT_COMPOSER=$(GOALPAD_HAS_JAK1_IMPORT_COMPOSER)
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) "$(GOALPAD_JAK1_IMPORT_ARCHIVE)"
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) "$(GOALPAD_JAK1_IMPORT_ARCHIVE)"
OTHER_LDFLAGS[sdk=iphonesimulator*] = $(inherited) "$(GOALPAD_JAK1_IMPORT_ARCHIVE)"
OTHER_LDFLAGS[sdk=xros*] = $(inherited) "$(GOALPAD_JAK1_IMPORT_ARCHIVE)"
OTHER_LDFLAGS[sdk=xrsimulator*] = $(inherited) "$(GOALPAD_JAK1_IMPORT_ARCHIVE)"
