.DS_Store

# Xcode user state and local build products
**/xcuserdata/
*.xcuserstate
/DerivedData/
/build/

# User-supplied or generated game data must stay local.
/LocalGameData/
/PreparedGameData/
/GOALPad/GameData/
*.iso
*.ISO
*.chd

# The AOT C for Jak 1's object files, emitted by goalc-cbackend-sweep. Generated, never committed:
# Scripts/generate-jak1-aot.sh rebuilds it from the OpenGOAL submodule.
/Generated/jak1-aot/*.c
/Generated/jak1-aot/*.h

# Local signing material
*.mobileprovision
*.p12
