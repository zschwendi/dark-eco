.DS_Store

# Xcode user state and local build products
**/xcuserdata/
*.xcuserstate
/DerivedData/
/build/

# User-supplied or generated game data must stay local.
/LocalGameData/
/PreparedGameData/
/GOALPad/GameData/
*.iso
*.ISO
*.chd

# AOT C emitted by goalc-cbackend-sweep. Generated, never committed.
/Generated/*-aot/*.c
/Generated/*-aot/*.h
/Generated/*-aot/coverage.tsv

# Local signing material
*.mobileprovision
*.p12
